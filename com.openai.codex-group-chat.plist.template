<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.openai.codex-group-chat</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__APP_DIR__/server.py</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8765</string>
        <string>--data-dir</string>
        <string>__APP_DIR__/data</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/codex-group-chat.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/codex-group-chat.error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>Umask</key>
    <integer>63</integer>
</dict>
</plist>
